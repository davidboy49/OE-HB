  "cards": [
    {
      "dot": "cyan",
      "title": "Authentication",
      "items": [
        "Login goes through /api/session/login to /auth/login",
        "12 hour JWT in an httpOnly auth_token cookie",
        "Username or email; SSO exchange at /auth/sso"
      ]
    },
    {
      "dot": "rose",
      "title": "Authorization",
      "items": [
        "JwtAuthGuard, then PermissionsGuard, on every route",
        "Grants re-read from the database each request",
        "Keys such as oe-plans:create and projects:update"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared code",
      "items": [
        "@oeportal/shared holds types and plan-item helpers",
        "Used by both the frontend and the backend"
      ]
    }
