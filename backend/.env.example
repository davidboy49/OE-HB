DATABASE_URL="postgresql://auditdesk:auditdesk@localhost:5432/auditdesk"
JWT_SECRET="change-me-in-production"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Realm base URL for the company Keycloak instance used by the mobile app's
# SSO login, e.g. https://sso.example.com/realms/company. Used by POST /auth/sso
# to verify incoming Keycloak access tokens against the realm's JWKS.
KEYCLOAK_ISSUER=""

# Bootstrap password for the seeded admin account (admin@auditdesk.com).
# Required by `prisma db seed` - every other seeded user starts with no password
# and needs one set via PATCH /users/:id/password after the admin logs in.
SEED_ADMIN_PASSWORD="change-me"
