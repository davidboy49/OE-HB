generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  passwordHash     String? // bcrypt hash; null until an admin sets a password for this user
  keycloakSub      String?           @unique // Keycloak's permanent user id ("sub"); set the first time this account signs in through SSO
  isActive         Boolean           @default(true) // false = cannot sign in and existing sessions stop working on the next request
  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  groupId          String?
  group            UserGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documents        Document[]
  findings         Finding[]
  reports          Report[]
  projects         OePlan[]          @relation("PlanMembers")
  meetingResponses MeetingResponse[]
}

model Department {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  businessUnitId     String? // Each Business Unit has its own departments; required by the UI, nullable for legacy rows
  businessUnit       BusinessUnit?       @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  users              User[]
  projects           Project[]
  openMeetings       OpenMeeting[]
  meetingResponses   MeetingResponse[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([businessUnitId, name])
}

model BusinessUnit {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UserGroup {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  role        String            @default("DEPT_PIC") // Unused legacy column, kept to avoid a migration - access is controlled by `permissions` below
  keycloakGroup String?         @unique // Keycloak group name (e.g. "/finance") that maps to this role on SSO sign-in; null = not synced from Keycloak
  users       User[]
  grants      GroupPermission[] // what members of this group may do, and how far (see scope)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Permission {
  key         String            @id // e.g. "oe-plans:create" - matches @RequirePermission() in code
  description String
  grants      GroupPermission[]
}

model OePlan {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  status          String // "PLANNING", "IN_PROGRESS", "REPORTING", "ARCHIVED"
  workflowStage   String   @default("DRAFTING") // "DRAFTING", "REVIEW", "PENDING_PIC", "APPROVED"
  deptPicIds      String   @default("") // Comma-separated list of User IDs representing department PICs
  departments     String   @default("") // Comma-separated list of Department IDs/Names
  // Scope is inherited from the linked Project's scope items, as a diff on top of them: which
  // inherited item ids this plan deactivated, plus any extra items it added locally (see
  // PlanItemsService.readScopeOverride/writeScopeOverride). The extra items themselves are
  // PlanItem rows (ownerType "OEPLAN_SCOPE_EXTRA"); inactiveScopeItemIds is the deactivated half.
  inactiveScopeItemIds String[] @default([])
  planningDetails String
  startDate       DateTime
  endDate         DateTime
  leaderId        String?
  memberNames     String   @default("")

  // Custom Scoping details fields - objectives/dataRequestType live as PlanItem rows
  // (ownerType "OEPLAN_OBJECTIVE" / "OEPLAN_DATA_REQUEST"), not columns here.
  riskProcess     String @default("")
  riskClass       String @default("")
  opEx            String @default("")
  fieldwork       String @default("")
  outcome         String @default("")
  focusArea       String @default("")
  // Timeline & Approvals - previously JSON-encoded strings (opExTimeline/approvals), flattened
  // to real columns for type safety and DB-level queryability. The API still accepts/returns
  // them as a single JSON string per group (see OePlansService) so existing clients are
  // unaffected - only the storage underneath changed.
  opExPresentationDate    String @default("")
  opExNotificationDate    String @default("")
  opExFieldWorkStart      String @default("")
  opExFieldWorkEnd        String @default("")
  opExFindingReportOffset Int    @default(0)
  opExFinalReportOffset   Int    @default(0)
  preparedByName          String @default("")
  preparedByTitle         String @default("")
  preparedDate            String @default("")
  approvedByName          String @default("")
  approvedByTitle         String @default("")
  approvedDate            String @default("")

  // Soft delete: this is a real audit record (findings, meeting minutes, schedules, reports
  // all hang off it) - a hard delete would cascade-destroy all of that with no undo. Excluded
  // from findAll() and treated as not-found everywhere else; the row and everything under it
  // survives.
  isDeleted Boolean @default(false)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          Document[]
  reports            Report[]
  members            User[]              @relation("PlanMembers")
  executionSchedules ExecutionSchedule[]
  openMeetings       OpenMeeting[]

  annualPlanId String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])

  createdBy String @default("") // Name of the user who created this plan
}

model Document {
  id         String   @id @default(uuid())
  title      String
  content    String
  oePlanId   String
  oePlan     OePlan   @relation(fields: [oePlanId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Finding {
  id                  String            @id @default(uuid())
  title               String
  description         String
  status              String // "OPEN", "UNDER_REVIEW", "CLOSED"
  severity            String // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  recommendation      String
  executionScheduleId String
  executionSchedule   ExecutionSchedule @relation(fields: [executionScheduleId], references: [id], onDelete: Cascade)
  memberId            String
  member              User              @relation(fields: [memberId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  title     String
  summary   String
  status    String // "DRAFT", "FINAL"
  oePlanId  String
  oePlan    OePlan   @relation(fields: [oePlanId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExecutionSchedule {
  id                    String    @id @default(uuid())
  oePlanId              String
  oePlan                OePlan    @relation(fields: [oePlanId], references: [id], onDelete: Cascade)
  findings              Finding[]
  departments           String    @default("")
  address               String
  visitNumber           String    @default("01")
  actualVisitDate       String
  oePeriod              String
  leadExecution         String
  teamMembers           String    @default("") // Comma-separated list of names
  additionalAttendees   String    @default("")
  attendeeConfirmations String    @default("{}")
  standards             String    @default("Work Procedure, work instruction, and policy")
  language              String    @default("English")
  status                String    @default("DRAFT")
  // objectives/scope live as PlanItem rows (ownerType "SCHEDULE_OBJECTIVE" / "SCHEDULE_SCOPE").
  departmentConcern     String    @default("")
  scheduleRows          String // JSON serialized rows: [{date, time, activity, conductBy, pIncharge}]
  ownerName             String    @default("")
  lastModifiedBy        String    @default("")
  qrToken               String    @default(uuid())
  departmentConsents    String    @default("{}") // JSON serialized: { [deptId]: { status, acceptedByUserId, acceptedByUserName, acceptedByUserEmail, timestamp, comments } }
  // Soft delete: hard-deleting used to cascade-destroy this schedule's Findings (real audit
  // records). Excluded from findAll() and treated as not-found everywhere else.
  isDeleted             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model OpenMeeting {
  id                    String            @id @default(uuid())
  oePlanId              String
  oePlan                OePlan            @relation(fields: [oePlanId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  responses             MeetingResponse[]
  departments           String            @default("")
  address               String            @default("HQ Main Conference Room / Virtual Meeting")
  visitNumber           String            @default("01")
  actualVisitDate       String
  oePeriod              String
  leadExecution         String
  teamMembers           String            @default("") // Comma-separated list of names
  additionalAttendees   String            @default("")
  attendeeConfirmations String            @default("{}")
  standards             String            @default("Work Procedure, work instruction, and policy")
  status                String            @default("DRAFT")
  // objectives/scope live as PlanItem rows (ownerType "MEETING_OBJECTIVE" / "MEETING_SCOPE").
  departmentConcern     String            @default("")
  scheduleRows          String // JSON serialized rows: [{date, time, activity, conductBy, pIncharge}]
  ownerName             String            @default("")
  lastModifiedBy        String            @default("")
  qrToken               String            @default(uuid())
  departmentConsents    String            @default("{}") // JSON serialized: { [deptId]: { status, acceptedByUserId, acceptedByUserName, acceptedByUserEmail, timestamp, comments } }
  isDeleted             Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  userName  String
  action    String
  details   String
  createdAt DateTime @default(now())
}

model SmtpConfig {
  id        String   @id @default("default")
  host      String   @default("smtp.mailtrap.io")
  port      Int      @default(2525)
  username  String   @default("")
  password  String   @default("")
  secure    Boolean  @default(false)
  fromEmail String   @default("alerts@auditdesk.com")
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}

model DocumentSequence {
  key        String   @id // per-prefix counter, e.g. "OEP" - not year-scoped
  currentVal Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AnnualPlan {
  id                 String              @id @default(uuid())
  planName           String
  period             String              @default("")
  comment            String              @default("")
  status             String              @default("DRAFT")
  createdBy          String              @default("") // Name of the user who created this plan
  qrToken            String              @unique @default(dbgenerated("(gen_random_uuid())::text")) // Unguessable, rotatable; the QR code encodes this, never the plan id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projects           Project[]
}

model Project {
  id           String      @id @default(uuid())
  annualPlanId String
  annualPlan   AnnualPlan  @relation(fields: [annualPlanId], references: [id], onDelete: Cascade)
  no           String
  projectName  String      @default("")
  departmentId String? // The single department this project is for
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  topic        String // Denormalised department name (kept in sync from departmentId)
  bu           String      @default("") // Denormalised Business Unit name (kept in sync from the department)
  type         String      @default("OE")
  revieweeIds  String
  conductDate  DateTime
  endDate      DateTime
  durationDay  Int
  purpose      String
  // objectives/scope live as PlanItem rows (ownerType "PROJECT_OBJECTIVE" / "PROJECT_SCOPE").
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  oePlans      OePlan[]
}

/// One response per user per Open Meeting. Identity and department are snapshotted so the
/// record still reads correctly after the user is renamed, moves department or is deleted.
model MeetingResponse {
  id               String      @id @default(uuid())
  meetingId        String
  meeting          OpenMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  respondentName   String
  respondentEmail  String
  departmentName   String
  businessUnitName String      @default("")
  status           String // "ACCEPTED" | "REVISION_REQUESTED"
  concern          String      @default("") // Sanitised HTML: the respondent's Concern of the Department Owner
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
}

/// One permission granted to a group, with the scope that limits how far it reaches.
model GroupPermission {
  groupId       String
  group         UserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  scope         String     @default("ALL") // ALL | BU | DEPARTMENT | MEMBER - only meaningful for scopable "view" permissions
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@id([groupId, permissionKey])
  @@index([permissionKey])
}

/// A single objectives/scope/data-request line item. Used to be a JSON-encoded array in a
/// String column on Project, OePlan, ExecutionSchedule and OpenMeeting (see PlanItemsService for
/// the full history and the exact `ownerType` tag each field uses). One owning record can have
/// many items; `ownerId` is that record's id, and `order` preserves the list's display order.
/// `itemId` is the wire-facing business id (e.g. "IOE-OBJ-01") the frontend already expects,
/// kept distinct from the row's own uuid `id` so re-ordering or re-numbering never changes
/// stable references.
model PlanItem {
  id        String   @id @default(uuid())
  ownerType String
  ownerId   String
  itemId    String
  text      String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType, ownerId])
}
